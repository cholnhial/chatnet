<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="chatnetgui" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debug">
				<Option output="bin/Debug/chatnetgui" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Debug/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-g" />
				</Compiler>
			</Target>
			<Target title="Release">
				<Option output="bin/Release/chatnetgui" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Release/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-O2" />
				</Compiler>
				<Linker>
					<Add option="-s" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-Wall" />
			<Add option="-fexceptions" />
		</Compiler>
		<Unit filename="chatnetgui.cpp" />
		<Unit filename="chatnetgui.h" />
		<Unit filename="common.cpp" />
		<Unit filename="connect_dialog.cpp" />
		<Unit filename="connect_dialog.h" />
		<Unit filename="global.h" />
		<Unit filename="logview.cpp" />
		<Unit filename="logview.h" />
		<Unit filename="main.cpp" />
		<Unit filename="network.cpp" />
		<Unit filename="network.h" />
		<Unit filename="statusbar.cpp" />
		<Unit filename="statusbar.h" />
		<Unit filename="userlist.cpp" />
		<Unit filename="userlist.h" />
		<Extensions>
			<code_completion />
			<envvars />
			<lib_finder disable_auto="1" />
			<debugger />
		</Extensions>
	</Project>
</CodeBlocks_project_file>
