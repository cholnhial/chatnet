OBJS = chatnetgui.o network.o userlist.o statusbar.o common.o logview.o main.o connect_dialog.o
FLAGS = `pkg-config --cflags --libs gtkmm-2.4`
data_dir = /usr/share/icons/hicolor
chatnetgui: $(OBJS)
	g++ -o chatnetgui $(OBJS) $(FLAGS)
main.o: main.cpp chatnetgui.h
	g++ -c main.cpp $(FLAGS)
chatnetgui.o: chatnetgui.cpp chatnetgui.h
	g++ chatnetgui.cpp -c $(FLAGS)

connect_dialog.o: connect_dialog.cpp connect_dialog.h
	g++ connect_dialog.cpp -c $(FLAGS)

userlist.o: userlist.cpp userlist.h
	g++ userlist.cpp -c $(FLAGS)

network.o: network.cpp network.h
	g++ network.cpp -c $(FLAGS)

common.o: common.cpp global.h
	g++ common.cpp -c $(FLAGS)
statusbar.o: statusbar.cpp statusbar.h
	g++ statusbar.cpp -c $(FLAGS)
logview.o: logview.cpp logview.h
	g++ logview.cpp -c $(FLAGS)
.PHONY : clean
clean:
	rm $(OBJS)
.PHONY : install
install:
	cp chatnetgui /usr/bin/
	cp ../icons/hicolor/48x48/apps/chatnetgui.png 
$(data_dir)/48x48/apps/
	cp ../icons/hicolor/scalable/apps/chatnetgui.png $(data_dir)/scalable/apps/
	cp ../desktop/chatnetgui.desktop /usr/share/applications
	gtk-update-icon-cache -f -t $(data_dir)

.PHONY : uninstall
uninstall:
	rm /usr/bin/chatnetgui
	rm $(data_dir)/48x48/apps/chatnetgui.png
	rm $(data_dir)/scalable/apps/chatnetgui.png
	rm /usr/share/applications/chatnetgui.desktop
	gtk-update-icon-cache -f -t $(data_dir)
